# Optional: create an API key in Google AI Studio.
GEMINI_API_KEY=

# Required for email/password accounts. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/slidecraft?retryWrites=true&w=majority
# Generate a private random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: Razorpay test/live credentials; keep these server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Create the ₹300/month plan in Razorpay and place the plan ID here.
RAZORPAY_MONTHLY_PLAN_ID=
# Set this in Razorpay Dashboard for your webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=
PORT=5000
